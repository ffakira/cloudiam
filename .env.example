# CloudIAM local development defaults.
# Copy to .env.local and fill only the values needed on this machine.

CLOUDIAM_DATABASE_URL=postgres://cloudiam:cloudiam@127.0.0.1:6000/cloudiam?sslmode=disable
CLOUDIAM_MIGRATE_DATABASE_URL=postgres://cloudiam:cloudiam@postgres:5432/cloudiam?sslmode=disable
DB_WAIT_SECONDS=60
CLOUDIAM_AUTH_WORKSPACE=local
CLOUDIAM_AUTH_ENDPOINT=cloudiam.internal.local
CLOUDIAM_AUTH_VERIFICATION_URI=http://127.0.0.1:8080/device
CLOUDIAM_HTTP_ADDR=127.0.0.1:8080
CLOUDIAM_DEPLOYMENT_ENV=development
CLOUDIAM_SERVICE_GRPC_PORT=50051
CLOUDIAM_SERVICE_HTTP_PORT=18080
CLOUDIAM_SERVICE_AUTH_VERIFICATION_URI=http://127.0.0.1:18080/device
CLOUDIAM_CONSOLE_SEED_USERNAME=admin
CLOUDIAM_CONSOLE_SEED_PASSWORD=<local-demo-password>
CLOUDIAM_CONSOLE_JWT_SECRET=<local-demo-secret>
CLOUDIAM_CONSOLE_JWT_TTL=8h
# Set true in TLS-terminated deployments so console session cookies include Secure.
CLOUDIAM_CONSOLE_COOKIE_SECURE=false
# Production bootstrap overrides are fail-closed by default.
CLOUDIAM_ALLOW_CONSOLE_SEED_IN_PRODUCTION=false
CLOUDIAM_ALLOW_INSECURE_DATABASE_IN_PRODUCTION=false
CLOUDIAM_DASHBOARD_DIST_DIR=../client/dist
CLOUDIAM_REDIS_URL=redis://127.0.0.1:6379/0

# AWS broker runtime.
# Do not commit real account IDs, access keys, or secret access keys.
AWS_PROFILE=
CLOUDIAM_AWS_ACCOUNT_ID=
CLOUDIAM_BROKER_USER_NAME=cloud-iam-broker
